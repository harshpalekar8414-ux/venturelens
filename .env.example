# ============================================================================
# VentureLens Environment Configuration
# ============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
PROJECT_NAME="VentureLens"
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL 16 + pgvector)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/venturelens

# Embedding Configuration
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

# AI Models (Google Gemini API)
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EXTRACTION_MODEL=gemini-3.7-flash
GEMINI_SYNTHESIS_MODEL=gemini-3.7-flash
GEMINI_THINKING_BUDGET=2048

# Web Search Discovery Provider (tavily, mock)
SEARCH_PROVIDER=mock
SEARCH_PROVIDER_API_KEY=your_search_api_key_here
